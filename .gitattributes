# 统一按内容自动判定，仓库内存 LF
* text=auto

# 脚本必须保持 LF，否则 bash 执行时报 $'\r'
*.sh   text eol=lf
*.bash text eol=lf
*.command text eol=lf

# 无扩展名的可执行脚本
.dsh/skills/executing-plans/scripts/*            text eol=lf
.dsh/skills/subagent-driven-development/scripts/* text eol=lf
.dsh/skills/systematic-debugging/find-polluter.sh text eol=lf

# 文档与前端源码
*.md   text eol=lf
*.js   text eol=lf
*.cjs  text eol=lf
*.ts   text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.dot  text eol=lf

# Windows 侧脚本保持 CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.ico binary
*.exe binary