/* 打字面板：深色、小圆角、0.5 px 描边，与 web 端截图（apps/unity/Shots/web-conv.png）对齐。
   右上角一块半透明面板：状态行 / 消息流 / 输入框 / 计数 + 发送。不引外部字体，字体走 PanelSettings。 */

.dialogue-panel {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 420px;
    height: 260px;
    padding: 12px;
    border-radius: 12px;
    background-color: rgba(18, 16, 22, 0.82);
    border-width: 0.5px;
    border-color: rgba(255, 255, 255, 0.18);
    color: rgb(236, 231, 240);
    font-size: 14px;
}

/* 状态行：小圆点 + 状态词 + 右侧三个 chip */
.status-row {
    flex-direction: row;
    align-items: center;
    height: 20px;
}

.status-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: rgb(122, 205, 168);
    margin-right: 6px;
}

.status {
    font-size: 12px;
    color: rgba(236, 231, 240, 0.72);
}

.status-fill {
    flex-grow: 1;
}

.chip {
    height: 18px;
    margin-left: 4px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 0;
    padding-bottom: 0;
    border-radius: 5px;
    border-width: 0.5px;
    border-color: rgba(255, 255, 255, 0.16);
    background-color: rgba(255, 255, 255, 0.06);
    color: rgba(236, 231, 240, 0.85);
    font-size: 11px;
}

/* 消息流 */
.log {
    flex-grow: 1;
    margin-top: 8px;
    margin-bottom: 8px;
}

.log .unity-scroll-view__content-container {
    flex-direction: column;
}

.line {
    font-size: 13px;
    white-space: normal;
    margin-bottom: 4px;
    max-width: 330px;
}

.line.hint {
    color: rgba(236, 231, 240, 0.55);
}

.line.player {
    align-self: flex-end;
    padding: 4px 8px;
    border-radius: 8px;
    background-color: rgba(146, 116, 196, 0.35);
    color: rgb(240, 236, 245);
}

.line.reply {
    align-self: flex-start;
    color: rgba(236, 231, 240, 0.92);
}

.line.notice {
    align-self: flex-start;
    padding: 4px 6px;
    border-radius: 6px;
    border-width: 0.5px;
    border-color: rgba(240, 160, 140, 0.5);
    background-color: rgba(240, 140, 120, 0.12);
    color: rgb(246, 196, 180);
}

.line.thinking {
    display: none;
    color: rgba(236, 231, 240, 0.55);
    font-style: italic;
}

/* 输入框：TextField 自己不带 placeholderText，占位提示是叠在上面的 Label */
.input-box {
    min-height: 54px;
    padding: 6px 8px;
    border-radius: 8px;
    border-width: 0.5px;
    border-color: rgba(255, 255, 255, 0.14);
    background-color: rgba(255, 255, 255, 0.05);
}

.input {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(236, 231, 240);
    font-size: 13px;
}

.input .unity-text-element,
.input .unity-base-text-field__input,
.input .unity-text-field__input {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(236, 231, 240);
    white-space: normal;
}

.placeholder {
    position: absolute;
    left: 9px;
    top: 8px;
    font-size: 13px;
    color: rgba(236, 231, 240, 0.38);
}

/* 底部：计数 + 发送 */
.footer {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    height: 22px;
}

.counter {
    flex-grow: 1;
    font-size: 11px;
    color: rgba(236, 231, 240, 0.45);
}

.send {
    height: 22px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 0;
    padding-bottom: 0;
    border-radius: 11px;
    border-width: 0.5px;
    border-color: rgba(255, 255, 255, 0.2);
    background-color: rgba(150, 120, 200, 0.5);
    color: rgb(255, 255, 255);
    font-size: 12px;
}
